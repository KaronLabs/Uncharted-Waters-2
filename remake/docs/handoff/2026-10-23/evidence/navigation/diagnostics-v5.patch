+  Cypress.on('window:before:load', (win) => {
+    const w = win as unknown as {
+      __uw2errs?: string[];
+      __uw2long?: string[];
+    };
+    w.__uw2errs = [];
+    w.__uw2long = [];
+    win.addEventListener('error', (e) =>
+      w.__uw2errs!.push(`E:${e.message}@${e.lineno}`),
+    );
+    win.addEventListener('unhandledrejection', (e) =>
+      w.__uw2errs!.push(`R:${String((e as PromiseRejectionEvent).reason)}`),
