{
  "name": "uw2-korean",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "postinstall": "node ./node_modules/electron/install.js",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "dist:portable": "vite build && electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  },
  "main": "electron-main.cjs",
  "build": {
    "appId": "labs.karon.uw2korean",
    "productName": "UW2-Korean",
    "electronDist": "node_modules/electron/dist",
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "UW2-Korean-Portable.exe"
    },
    "directories": {
      "output": "release"
    }
  }
}