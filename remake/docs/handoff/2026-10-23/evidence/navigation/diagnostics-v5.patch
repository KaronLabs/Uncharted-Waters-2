+          ) => {
+            observe: (opts: { type: string; buffered: boolean }) => void;
+          };
+        }
+      ).PerformanceObserver;
+      const observer = new PerformanceObserverCtor((list) => {
+        const entries = (
+          list as {
+            getEntries: () => {
+              startTime: number;
+              duration: number;
+              name: string;
+              attribution: { containerSrc?: string; containerName?: string }[];
+            }[];
+          }
+        ).getEntries();
+        for (const entry of entries) {
+          if (entry.duration < 500) continue;
+          const source = entry.attribution
+            ?.map(
+              (a) => `${a.containerName ?? ''}:${a.containerSrc ?? ''}`,
+            )
+            .join('|');
+          w.__uw2long!.push(
+            `t=${Math.round(entry.startTime)}ms dur=${Math.round(
+              entry.duration,
+            )}ms ${entry.name} src=${source ?? '?'}`,
+          );
+          if (w.__uw2long.length > 40) w.__uw2long.shift();
+        }
+      });
+      observer.observe({ type: 'longtask', buffered: true });
+    } catch {
+      w.__uw2errs!.push('longtask-observer-unavailable');
+    }
+  });
+
   it(
     'plays M0 through M3, including real Basra and Istanbul voyages, and comes home',
     { defaultCommandTimeout: 12_000 },
